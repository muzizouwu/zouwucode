/* ── ZOUWUCODE TUI Theme ─────────────────────────────────────────────────────
   Palette mirrors the GUI (webui/static/style.css): graphite surfaces, cyan
   accent, violet secondary. Only selectors that the app actually renders are
   styled — the old .message-* rules were dead (chat is drawn as Rich text).
   ────────────────────────────────────────────────────────────────────────── */

Screen {
    background: #0a0e16;
    color: #e6edf7;
}

/* ── Header ──────────────────────────────────────────────────────────────── */
#header {
    height: 3;
    background: #111826;
    border-bottom: solid #1e293b;
    padding: 0 2;
}
#header-title {
    content-align: left middle;
    text-style: bold;
    color: #22d3ee;
}
#header-mode {
    content-align: right middle;
    text-style: bold;
    color: #a78bfa;
}

/* ── Chat ────────────────────────────────────────────────────────────────── */
#chat-container {
    height: 1fr;
    padding: 0 1;
}
#chat-view {
    background: #0a0e16;
    border: round #1e293b;
    border-title-color: #22d3ee;
    padding: 1 2;
}
#chat-view:focus {
    border: round #22d3ee;
}

/* ── Composer ────────────────────────────────────────────────────────────── */
#input-area {
    height: auto;
    background: #111826;
    border-top: solid #1e293b;
    padding: 1 2;
}
#input-box {
    height: 3;
    background: #0e1420;
    color: #e6edf7;
    border: round #1e293b;
    padding: 0 1;
}
#input-box:focus {
    border: round #22d3ee;
}

/* ── Status bar ──────────────────────────────────────────────────────────── */
#status-bar {
    height: 1;
    background: #0e1420;
    color: #9aa8bd;
    padding: 0 2;
}
#status-left { width: 1fr; }
#status-right {
    width: 1fr;
    content-align: right middle;
    color: #6b7a90;
}

/* ── Footer ──────────────────────────────────────────────────────────────── */
#footer {
    height: 1;
    background: #111826;
    padding: 0 2;
}
#shortcuts {
    width: 1fr;
    color: #6b7a90;
    content-align: left middle;
}
#footer-progress {
    width: auto;
    color: #22d3ee;
    content-align: right middle;
    text-style: bold;
}
